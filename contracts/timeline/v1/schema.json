{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracecue:timeline:v1",
  "title": "TraceCue timeline.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "source_id",
    "generated_at",
    "producer",
    "coverage",
    "channels",
    "intervals"
  ],
  "properties": {
    "schema_version": { "const": "timeline.v1" },
    "document_id": { "$ref": "#/$defs/nonEmptyId" },
    "source_id": { "$ref": "#/$defs/nonEmptyId" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "producer": { "$ref": "#/$defs/producer" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/channel" }
    },
    "intervals": {
      "type": "array",
      "items": { "$ref": "#/$defs/interval" }
    }
  },
  "$defs": {
    "nonEmptyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_at", "end_at", "completeness"],
      "properties": {
        "start_at": { "$ref": "#/$defs/timestamp" },
        "end_at": { "$ref": "#/$defs/timestamp" },
        "completeness": {
          "enum": ["complete", "partial", "unknown"]
        }
      }
    },
    "externalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": {
          "enum": ["mmwave", "door_contact", "nvr_event", "other"]
        },
        "external_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/externalRef" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "gate": { "enum": ["pass", "fail", "unknown"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "mediaWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_at", "end_at"],
      "properties": {
        "start_at": { "$ref": "#/$defs/timestamp" },
        "end_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "track_id": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "minProperties": 1
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel_id", "event_type", "start_at", "end_at"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "channel_id": { "$ref": "#/$defs/nonEmptyId" },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 120
        },
        "start_at": { "$ref": "#/$defs/timestamp" },
        "end_at": { "$ref": "#/$defs/timestamp" },
        "quality": { "$ref": "#/$defs/quality" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "media_window": { "$ref": "#/$defs/mediaWindow" },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "source_ref": { "$ref": "#/$defs/sourceRef" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      }
    }
  }
}
